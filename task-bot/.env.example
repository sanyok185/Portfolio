# Токен бота від @BotFather
BOT_TOKEN=

# Ключ API з https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Модель Claude. Дешевший варіант: claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5

# Твій часовий пояс
TIMEZONE=Europe/Kyiv

# Telegram ID людей, яким можна користуватися ботом (через кому).
# Якщо залишити порожнім, ботом зможе користуватися будь-хто.
# Свій ID дізнаєшся, якщо заповниш тут будь-яке число й напишеш боту.
ALLOWED_USER_IDS=
